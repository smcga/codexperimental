{
  "name": "demoscene-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run gen:explicitpixels",
    "dev": "vite",
    "prebuild": "npm run gen:explicitpixels",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "docs:effects": "tsx scripts/generateEffectsDocs.ts",
    "docs:chronology": "tsx scripts/generateEffectChronologyDocs.ts",
    "docs:check": "vitest run src/renderer/effects/effectsDocs.test.ts src/renderer/transitions/transitionsDocs.test.ts",
    "gen:explicitpixels": "tsx scripts/generateExplicitPixels.ts",
    "test:integration": "vitest run api/kv.integration.test.ts",
    "docs:transitions": "tsx scripts/generateTransitionsDocs.ts",
    "build:release": "npm run test && npm run docs:check && vite build --mode release",
    "release:check": "npm run test && npm run docs:check && npm run build:release",
    "package:release": "tsx scripts/packageRelease.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
