      {
        "t": 22.8,
        "type": "output",
        "text": "Four years ago…\n"
      },
      {
        "t": 25.6,
        "type": "output",
        "text": "In the year 2022…\n"
      },
      {
        "t": 30,
        "type": "prompt",
        "text": "demo@machine:~$ "
      },
      {
        "t": 30.1,
        "type": "type",
